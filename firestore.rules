rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isEditor() {
      return isAuthenticated() &&
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'editor' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles — any authenticated user can manage (portal is behind staff password)
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Dataset metadata (public read, editor write)
    match /dataset_metadata/{datasetId} {
      allow read: if true;
      allow create, update: if isEditor();
      allow delete: if isAdmin(); // Only admins can permanently delete
    }

    // Full datasets with chunks subcollection
    match /datasets/{datasetId} {
      allow read: if true;
      allow create, update: if isEditor();
      allow delete: if isAdmin(); // Only admins can permanently delete

      // Dataset chunks subcollection
      match /chunks/{chunkId} {
        allow read: if true;
        allow create, update: if isEditor();
        allow delete: if isAdmin();
      }
    }

    // Field observations metadata
    match /field_observations_meta/{observationId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isEditor() || isAdmin();
    }

    // Portal categories — editors can create/update, only admins can hard-delete
    match /portal_categories/{categoryId} {
      allow read: if true;
      allow create, update: if isEditor();
      allow delete: if isAdmin();
    }

    // Portal configuration — editors can update, admins can delete
    match /portal_config/{configId} {
      allow read: if true;
      allow create, update: if isEditor();
      allow delete: if isAdmin();
    }

    // ProDoc tracker data — editors can modify, admins can delete
    match /prodoc-tracker/{docId} {
      allow read: if true;
      allow create, update: if isEditor();
      allow delete: if isAdmin();
    }

    // ProDocs collection
    match /prodocs/{docId} {
      allow read: if true;
      allow create, update: if isEditor();
      allow delete: if isAdmin();
    }

    // NBSAP targets
    match /nbsap_targets/{targetId} {
      allow read: if true;
      allow create, update: if isEditor();
      allow delete: if isAdmin();
    }

    // Protected areas (CCAs & MPAs) — editors can create/update, only admins can hard-delete
    match /protectedAreas/{areaId} {
      allow read: if true;
      allow create, update: if isEditor();
      allow delete: if isAdmin();
    }

    // Activities — authenticated users can create/update own, editors can manage all
    match /activities/{activityId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isEditor();
    }

    // File manager — folders
    match /fm_folders/{folderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin(); // Hard-delete only by admin
    }

    // File manager — files
    match /fm_files/{fileId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin(); // Hard-delete only by admin
    }

    // File manager — shares
    match /fm_shares/{shareId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // System configuration (admin only)
    match /system_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Audit logs — write-once, immutable, readable by editors and admins
    match /audit_logs/{logId} {
      allow read: if isEditor();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Logs are immutable
    }

    // Activity logs (legacy) — immutable
    match /activity_logs/{logId} {
      allow read: if isEditor();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Messaging
    match /conversations/{convId} {
      allow read, write: if isAuthenticated();
    }
    match /messages/{msgId} {
      allow read, write: if isAuthenticated();
    }
    match /notifications/{notifId} {
      allow read, write: if isAuthenticated();
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
