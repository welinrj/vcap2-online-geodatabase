rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isEditor() {
      return isAuthenticated() &&
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'editor' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      // Anyone can read user profiles (for collaboration features)
      allow read: if true;

      // Users can create their own profile during signup
      allow create: if isOwner(userId);

      // Users can update their own profile
      // Admins can update any profile
      allow update: if isOwner(userId) || isAdmin();

      // Only admins can delete user profiles
      allow delete: if isAdmin();
    }

    // Dataset metadata (public read, authenticated write)
    match /dataset_metadata/{datasetId} {
      // Public read access for all datasets
      allow read: if true;

      // Editors and admins can create, update, delete
      allow create, update: if isEditor();
      allow delete: if isEditor() || isAdmin();
    }

    // Full datasets (public read, authenticated write)
    match /datasets/{datasetId} {
      // Public read access
      allow read: if true;

      // Editors and admins can create, update, delete
      allow create, update: if isEditor();
      allow delete: if isEditor() || isAdmin();
    }

    // Field observations (for real-time dashboard)
    // Stored in Realtime Database, not Firestore
    // But we can keep metadata here
    match /field_observations_meta/{observationId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isEditor() || isAdmin();
    }

    // Portal categories
    match /portal_categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Portal configuration
    match /portal_config/{configId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ProDocs
    match /prodocs/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // NBSAP targets
    match /nbsap_targets/{targetId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Protected areas (CCAs & MPAs)
    match /protectedAreas/{areaId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // System configuration (admin only)
    match /system_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Activity logs (write-only for users, read for admins)
    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Logs are immutable
    }

  }
}
