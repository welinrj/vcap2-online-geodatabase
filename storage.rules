rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isReasonableSize() {
      return request.resource.size < 50 * 1024 * 1024; // 50MB limit
    }

    // GeoJSON datasets - public read, authenticated write
    match /geojson-datasets/{datasetId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isReasonableSize();
      allow delete: if isAuthenticated();
    }

    // Field data - public read, authenticated write
    match /field-data/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isReasonableSize();
      allow delete: if isAuthenticated();
    }

    // User profile pictures
    match /user-avatars/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isReasonableSize();
      allow delete: if isAuthenticated();
    }

    // File Manager uploads — any authenticated user can read/write
    match /fm-files/{allPaths=**} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isReasonableSize();
      allow delete: if isAuthenticated();
    }

    // System files
    match /system/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
